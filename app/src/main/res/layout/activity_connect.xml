<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="12dp"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PhoneDeck"
                    android:textColor="@color/txt"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:text="Paste the link from your PC (Wi-Fi mode), or use Bluetooth with no network."
                    android:textColor="@color/dim"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/link"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_edit"
                    android:hint="http://192.168.43.175:8080/?key=..."
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/txt"
                    android:textColorHint="@color/dim"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/paste"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_pri"
                        android:stateListAnimator="@null"
                        android:text="Paste &amp; Connect"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/go"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_btn"
                        android:minWidth="96dp"
                        android:stateListAnimator="@null"
                        android:text="Connect"
                        android:textAllCaps="false"
                        android:textColor="@color/txt"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/bt"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn"
                    android:stateListAnimator="@null"
                    android:text="Bluetooth keyboard &amp; mouse (no network)"
                    android:textAllCaps="false"
                    android:textColor="@color/txt"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/recent"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn"
                        android:stateListAnimator="@null"
                        android:text="Recent"
                        android:textAllCaps="false"
                        android:textColor="@color/txt"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/find"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn"
                        android:stateListAnimator="@null"
                        android:text="Find PC"
                        android:textAllCaps="false"
                        android:textColor="@color/txt"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/test"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn"
                        android:stateListAnimator="@null"
                        android:text="Test link"
                        android:textAllCaps="false"
                        android:textColor="@color/txt"
                        android:textSize="13sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Connect automatically when the app opens"
                    android:textColor="@color/txt"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/sugg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Word suggestions (keyboard mode and link mode)"
                    android:textColor="@color/txt"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/msg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:minHeight="20dp"
                    android:textColor="@color/dim"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edit"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:text="Phone and PC must be on the same Wi-Fi or hotspot, with PhoneDeck running on the PC. While connected, press Back twice to disconnect."
                    android:textColor="@color/dim"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/forget"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent"
                    android:stateListAnimator="@null"
                    android:text="Forget saved link"
                    android:textAllCaps="false"
                    android:textColor="@color/dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
