<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- suggestion bar: filled in by DeckActivity.buildSuggestionBar() -->
        <LinearLayout
            android:id="@+id/sugBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/panel"
            android:orientation="horizontal"
            android:padding="2dp" />

        <!-- connection banner (only visible while there is a problem / just recovered) -->
        <TextView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/warn"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- download progress -->
        <LinearLayout
            android:id="@+id/dlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/panel"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dlText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="@color/txt"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dlOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="Open"
                    android:textColor="@color/acc"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/dlClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="✕"
                    android:textColor="@color/dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/dlProg"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="1000"
                android:progressTint="@color/acc" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/errorBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/txt"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/errorInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retry"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_pri"
                android:stateListAnimator="@null"
                android:text="Retry now"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/find"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:stateListAnimator="@null"
                android:text="Find PC"
                android:textAllCaps="false"
                android:textColor="@color/txt"
                android:textStyle="bold" />

            <Button
                android:id="@+id/change"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn"
                android:stateListAnimator="@null"
                android:text="Change link"
                android:textAllCaps="false"
                android:textColor="@color/txt"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
